#!/usr/bin/env bash
set -e
# ROS Humble cv_bridge is built against the system NumPy ABI. Avoid Conda and
# user-site wheels (often NumPy 2 / pip OpenCV) for this ROS image process.
export PYTHONNOUSERSITE=1
exec /usr/bin/python3 -s -c 'from bunker_tag_follower.extrinsic_recorder import main; main()'
