  <version>0.1.0</version>
  <description>Save named Bunker poses and send them to Nav2.</description>
  <maintainer email="maintainer@example.com">Bunker workspace maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
